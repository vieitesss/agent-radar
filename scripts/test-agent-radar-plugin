#!/usr/bin/env sh
# shellcheck shell=sh disable=SC1007
set -eu

repo_dir=$(CDPATH= cd "$(dirname "$0")/.." && pwd -P) || exit 1
tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-radar-plugin-test.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM HUP

log=$tmp/tmux.log
hooks=$tmp/hooks
: > "$log"
printf '%s\n' 'session-window-changed[0] display-message user-hook' > "$hooks"
TMUX_HOOKS=$hooks
export TMUX_HOOKS
mkdir "$tmp/bin"
cat > "$tmp/bin/tmux" <<'EOF'
#!/usr/bin/env sh
stock_slot='#[align=centre]#{P:#{?pane_active,#[reverse],}#{pane_index}[#{pane_width}x#{pane_height}]#[default] }'
case "$1" in
    -f)
        # Default probe on a throwaway server: tmux -f /dev/null -S sock start-server ...
        printf 'probe %s\n' "$*" >> "$TMUX_LOG"
        printf '%s\n' "${TEST_DEFAULT-$stock_slot}"
        ;;
    show-hooks)
        cat "$TMUX_HOOKS"
        ;;
    show-option)
        case "$3" in
            @agent-radar-glance) printf '%s\n' "${TEST_GLANCE:-on}" ;;
            @agent-radar-glance-orig-status) printf '%s\n' "${TEST_ORIG_STATUS:-}" ;;
            @agent-radar-glance-orig-format) printf '%s\n' "${TEST_ORIG_FORMAT:-}" ;;
            status-left) printf 'left ' ;;
            status-format\[1\])
                if [ "${TEST_SLOT+x}" = x ]; then printf '%s\n' "$TEST_SLOT"
                else printf '%s\n' "$stock_slot"; fi
                ;;
            status) printf '%s\n' "${TEST_STATUS:-on}" ;;
            window-status-format) printf '#I:#W' ;;
            window-status-current-format) printf '#[reverse]#I:#W' ;;
            *) exit 0 ;;
        esac
        ;;
    set-option|bind-key|run-shell|display-message)
        printf '%s\n' "$*" >> "$TMUX_LOG"
        ;;
    set-hook)
        printf '%s\n' "$*" >> "$TMUX_LOG"
        case "$2" in
            -ga)
                index=$(wc -l < "$TMUX_HOOKS" | tr -d ' ')
                printf 'session-window-changed[%s] %s\n' "$index" "$4" >> "$TMUX_HOOKS"
                ;;
            -g)
                printf 'session-window-changed[0] %s\n' "$4" > "$TMUX_HOOKS"
                ;;
        esac
        ;;
    *) echo "unexpected tmux $*" >&2; exit 1 ;;
esac
EOF
chmod +x "$tmp/bin/tmux"

PATH=$tmp/bin:$PATH TMUX_LOG=$log "$repo_dir/agent-radar.tmux"

grep -F 'set-option -g window-status-format #{?@agent-radar-window-stopped,' "$log" >/dev/null || {
    echo 'window-status-format does not include agent-radar stopped marker' >&2
    exit 1
}
grep -F 'set-option -g window-status-current-format #{?@agent-radar-window-stopped,' "$log" >/dev/null || {
    echo 'window-status-current-format does not include agent-radar stopped marker' >&2
    exit 1
}
grep -F "scripts/agent-radar-list'" "$log" >/dev/null || {
    echo 'popup binding does not single-quote the list script path (breaks on plugin paths with spaces)' >&2
    exit 1
}
grep -F "run-shell -b '" "$log" | grep -F "scripts/agent-radar-poller' start" >/dev/null || {
    echo 'poller spawn does not single-quote the script path (run-shell goes through sh -c; breaks on plugin paths with spaces)' >&2
    exit 1
}
grep -F "set-option -g status-format[1] #('$repo_dir/scripts/agent-radar-glance'" "$log" >/dev/null || {
    echo 'glance format was not written to status-format[1]' >&2
    exit 1
}
grep -F 'set-option -g status 2' "$log" >/dev/null || {
    echo 'status was not raised to 2 for the glance line' >&2
    exit 1
}
grep -F 'set-option -gq @agent-radar-glance-orig-status' "$log" >/dev/null || {
    echo 'pre-raise status was not saved to @agent-radar-glance-orig-status' >&2
    exit 1
}
grep -F 'set-option -gq @agent-radar-glance-state on' "$log" >/dev/null || {
    echo 'glance live state was not set on' >&2
    exit 1
}
grep -F "set-hook -ga session-window-changed run-shell -b \"'$repo_dir/scripts/agent-radar-status' '#{session_name}'\"" "$log" >/dev/null || {
    echo 'session-window-changed hook must append one quoted command with a quoted script path' >&2
    exit 1
}
grep -F 'display-message user-hook' "$hooks" >/dev/null || {
    echo 'plugin did not preserve the pre-existing session-window-changed hook' >&2
    exit 1
}
PATH=$tmp/bin:$PATH TMUX_LOG=$log "$repo_dir/agent-radar.tmux"
agent_hook_count=$(grep -c 'agent-radar-status' "$hooks" || true)
[ "$agent_hook_count" -eq 1 ] || {
    echo 're-sourcing added a duplicate agent-radar hook' >&2
    exit 1
}
grep -F "bind-key A run-shell -b '$repo_dir/scripts/agent-radar-toggle'" "$log" >/dev/null || {
    echo 'toggle binding does not single-quote the toggle script path' >&2
    exit 1
}

# --- Custom formats with stock tokens still belong to the user ---
for slot in 'custom #{pane_index}' 'custom #{pane_width}x#{pane_height}'; do
    : > "$log"
    PATH=$tmp/bin:$PATH TMUX_LOG=$log TEST_SLOT="$slot" "$repo_dir/agent-radar.tmux"
    grep -F 'agent-radar: status line 2 is in use' "$log" >/dev/null || {
        echo 'plugin did not reject custom row' >&2; exit 1
    }
    if grep -F 'set-option -g status-format[1]' "$log" >/dev/null; then
        echo 'plugin overwrote custom row' >&2; exit 1
    fi
done

# --- Re-source while on must retain the original one-row baseline ---
: > "$log"
PATH=$tmp/bin:$PATH TMUX_LOG=$log TEST_STATUS=2 TEST_ORIG_STATUS=on \
    TEST_SLOT="#('$repo_dir/scripts/agent-radar-glance' '#{session_name}' '#{window_width}')" \
    "$repo_dir/agent-radar.tmux"
grep -F 'set-option -gq @agent-radar-glance-state on' "$log" >/dev/null || {
    echo 'reload did not recognize its own glance row' >&2; exit 1
}
if grep -F 'set-option -gq @agent-radar-glance-orig-status 2' "$log" >/dev/null; then
    echo 'reload replaced the original one-row baseline with two rows' >&2; exit 1
fi

# --- Reload with @agent-radar-glance off tears down an existing glance ---
: > "$log"
PATH=$tmp/bin:$PATH TMUX_LOG=$log TEST_GLANCE=off TEST_STATUS=2 TEST_ORIG_STATUS=on \
    TEST_SLOT="#('$repo_dir/scripts/agent-radar-glance' '#{session_name}' '#{window_width}')" \
    "$repo_dir/agent-radar.tmux"
grep -F 'set-option -g status-format[1] #[align=centre]#{P:#{?pane_active,#[reverse],}#{pane_index}[#{pane_width}x#{pane_height}]#[default] }' "$log" >/dev/null || {
    echo 'reload with glance off did not restore stock status-format[1]' >&2
    exit 1
}
grep -F 'set-option -g status on' "$log" >/dev/null || {
    echo 'reload with glance off did not lower status' >&2
    exit 1
}
grep -F 'set-option -gu @agent-radar-glance-state' "$log" >/dev/null || {
    echo 'reload with glance off did not unset @agent-radar-glance-state' >&2
    exit 1
}

# --- tmux 3.7 default on row 2 is free, and is kept for teardown ---
stock_37='#[align=left]#{R: ,#{n:#{session_name}}}P: #[norange default]#[list=on align=#{status-justify}]#[list=left-marker]<#[list=right-marker]>#[list=on]#{P:#[range=pane|#{pane_id} #{E:pane-status-style}]#[push-default]#{T:window-pane-status-format}#[pop-default]#[norange list=on default]  ,#[range=pane|#{pane_id} list=focus #{?#{!=:#{E:pane-status-current-style},default},#{E:pane-status-current-style},#{E:pane-status-style}}]#[push-default]#{T:window-pane-current-status-format}#[pop-default]#[norange list=on default] }'
: > "$log"
PATH=$tmp/bin:$PATH TMUX_LOG=$log TEST_SLOT="$stock_37" "$repo_dir/agent-radar.tmux"
grep -F "set-option -g status-format[1] #('$repo_dir/scripts/agent-radar-glance'" "$log" >/dev/null || {
    echo 'glance did not claim a row holding the tmux 3.7 default' >&2; exit 1
}
grep -F "set-option -gq @agent-radar-glance-orig-format $stock_37" "$log" >/dev/null || {
    echo 'claim did not keep the row text it replaced' >&2; exit 1
}
if grep -F 'probe ' "$log" >/dev/null; then
    echo 'a known default started a probe server' >&2; exit 1
fi

# --- An unknown default is free when this tmux reports it as built in ---
: > "$log"
PATH=$tmp/bin:$PATH TMUX_LOG=$log TEST_SLOT='future default' TEST_DEFAULT='future default' \
    "$repo_dir/agent-radar.tmux"
grep -F 'probe -f /dev/null -S ' "$log" | grep -F 'show-option -gqv status-format[1]' >/dev/null || {
    echo 'unknown row text did not ask a clean tmux for its default' >&2; exit 1
}
grep -F "set-option -g status-format[1] #('$repo_dir/scripts/agent-radar-glance'" "$log" >/dev/null || {
    echo 'glance did not claim a row holding this tmux default' >&2; exit 1
}

# --- Teardown puts back the kept text ---
: > "$log"
PATH=$tmp/bin:$PATH TMUX_LOG=$log TEST_GLANCE=off TEST_STATUS=2 TEST_ORIG_STATUS=on \
    TEST_ORIG_FORMAT="$stock_37" \
    TEST_SLOT="#('$repo_dir/scripts/agent-radar-glance' '#{session_name}' '#{window_width}')" \
    "$repo_dir/agent-radar.tmux"
grep -F "set-option -g status-format[1] $stock_37" "$log" >/dev/null || {
    echo 'teardown did not restore the kept row text' >&2; exit 1
}
grep -F 'set-option -gu @agent-radar-glance-orig-format' "$log" >/dev/null || {
    echo 'teardown did not drop the kept row text' >&2; exit 1
}

# --- Teardown with nothing kept falls back to this tmux default ---
: > "$log"
PATH=$tmp/bin:$PATH TMUX_LOG=$log TEST_GLANCE=off TEST_STATUS=2 TEST_ORIG_STATUS=on \
    TEST_DEFAULT='future default' \
    TEST_SLOT="#('$repo_dir/scripts/agent-radar-glance' '#{session_name}' '#{window_width}')" \
    "$repo_dir/agent-radar.tmux"
grep -F 'set-option -g status-format[1] future default' "$log" >/dev/null || {
    echo 'teardown without kept text did not restore this tmux default' >&2; exit 1
}

printf 'agent-radar-plugin ok\n'
