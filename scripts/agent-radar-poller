#!/usr/bin/env sh
set -eu

command -v tmux >/dev/null 2>&1 || exit 0
script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P) || exit 0
store_cmd=$script_dir/agent-radar-store
transition_cmd=$script_dir/agent-radar-transition
match_cmd=$script_dir/agent-radar-match
throttle_file="${AGENT_RADAR_SOUND_THROTTLE_FILE:-}"
. "$script_dir/agent-radar-record-columns"
eval "$(agent_radar_record_column_vars)"

opt() {
    v=$(tmux show-option -gqv "$1" 2>/dev/null || true)
    [ -n "$v" ] && printf '%s\n' "$v" || printf '%s\n' "$2"
}

pid_val() {
    tmux show-option -gqv @agent-radar-pid 2>/dev/null || true
}

pid_set() {
    tmux set-option -gq @agent-radar-pid "$1"
}

pid_unset() {
    owner=${1:-}
    if [ -n "$owner" ] && [ "$(pid_val)" != "$owner" ]; then
        return 0
    fi
    tmux set-option -gqu @agent-radar-pid 2>/dev/null || true
}

# Read the last_change|armed|state hot-loop fields for a pane in ONE awk pass.
# ponytail: consumes the store's shared records() pipe contract; a per-field
# store subcommand would refork tmux and undo 011's latency win.
record_hot() {
    awk -F '|' \
        -v pane="$1" \
        -v col_pane="$agent_radar_record_col_pane" \
        -v col_last="$agent_radar_record_col_last_change" \
        -v col_armed="$agent_radar_record_col_armed" \
        -v col_state="$agent_radar_record_col_state" \
        '$col_pane == pane { print $col_last "|" $col_armed "|" $col_state; exit }' \
        "$records_file"
}

set_pane() {
    AGENT_RADAR_STORE_RECORDS_FILE=$records_file "$store_cmd" set "$@"
}

clear_pane() {
    "$store_cmd" clear "$1"
}

detect_working() {
    # Capture without -e: opencode colors each square, and plain text keeps the bar contiguous.
    LC_ALL=C tmux capture-pane -pJ -t "$1" 2>/dev/null | "$match_cmd" "$work_re"
}

agent_for_tty() {
    tty=${1#/dev/}
    allow=$2

    # Match on the full command line, not just comm: hermes (and other
    # python/node-launched harnesses) exec an interpreter — `/path/python
    # /path/hermes` — so comm is `python` (or a truncated path), never the
    # harness name. argv[0] covers native binaries; remaining args are only
    # scanned for interpreter/launcher processes so a pane running
    # `grep hermes` or `vim hermes` isn't mistaken for an agent pane.
    ps -t "$tty" -o comm= -o args= 2>/dev/null | while IFS= read -r line; do
        [ -n "$line" ] || continue
        comm=${line%% *}
        name=${comm##*/}
        name=${name#-}
        case "$allow" in
            *",$name,"*) printf '%s\n' "$name"; exit 0 ;;
        esac

        rest=${line#* }
        set -- $rest
        [ "$#" -gt 0 ] || continue
        prog=${1##*/}
        prog=${prog#-}
        case "$allow" in
            *",$prog,"*) printf '%s\n' "$prog"; exit 0 ;;
        esac
        case "$prog" in
            python*|node|npx|bun|deno|ruby|perl|php|bash|sh|zsh|fish|dash|ksh|tcsh|pwsh|uv|uvx|pipx)
                shift
                for arg in "$@"; do
                    aname=${arg##*/}
                    case "$allow" in
                        *",$aname,"*) printf '%s\n' "$aname"; exit 0 ;;
                    esac
                done
                ;;
        esac
    done
}

notify_stopped() {
    if [ "$(opt @agent-radar-notify on)" = on ]; then
        if [ "$(uname -s 2>/dev/null || true)" = Darwin ] && command -v osascript >/dev/null 2>&1; then
            osascript - "$1" "$2" <<'APPLESCRIPT' >/dev/null 2>&1 &
on run argv
  display notification (item 2 of argv) with title ("agent-radar: " & item 1 of argv & " stopped")
end run
APPLESCRIPT
        elif command -v notify-send >/dev/null 2>&1; then
            notify-send "agent-radar: $1 stopped" "$2" >/dev/null 2>&1 &
        fi
    fi

    [ "$(opt @agent-radar-sound off)" = on ] || return 0

    if [ -n "$throttle_file" ]; then
        last_sound=$(stat -c %Y "$throttle_file" 2>/dev/null || stat -f %m "$throttle_file" 2>/dev/null || true)
        if [ -n "$last_sound" ]; then
            elapsed=$(($(date +%s) - last_sound))
            if [ "$elapsed" -lt 3 ]; then
                return 0
            fi
        fi
        touch "$throttle_file" 2>/dev/null || true
    fi

    if [ "$(uname -s 2>/dev/null || true)" = Darwin ] && command -v afplay >/dev/null 2>&1; then
        afplay /System/Library/Sounds/Ping.aiff >/dev/null 2>&1 &
        return 0
    fi

    if command -v canberra-gtk-play >/dev/null 2>&1; then
        canberra-gtk-play -i complete >/dev/null 2>&1 &
        return 0
    elif command -v paplay >/dev/null 2>&1; then
        paplay /usr/share/sounds/freedesktop/stereo/complete.oga >/dev/null 2>&1 &
        return 0
    fi

    return 0
}

valid_number() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

poll_once() {
    now=$(date +%s)
    idle=$(opt @agent-radar-idle-seconds 3)
    valid_number "$idle" || idle=3
    allow=,$(opt @agent-radar-processes 'pi,claude,codex,opencode,hermes,aider,cursor'),
    # Working-indicator pattern (ERE, matched byte-wise under LC_ALL=C). Default
    # matches pi/codex's braille glyph, Claude Code's live status line (spinner
    # + word + ellipsis + opening parenthesis, unlike its completed-turn
    # summary), opencode's 4+-square bar, or hermes' running hint.
    work_re=$(opt @agent-radar-working-pattern "$(printf '\342[\240-\243]|(\342\226\240|\342\254\235){4,}|msg=interrupt|(\302\267|\342\234\242|\342\234\263|\342\234\266|\342\234\273|\342\234\275) [[:alpha:]]+\342\200\246 \\(')")
    present_panes=$(mktemp "${TMPDIR:-/tmp}/agent-radar.XXXXXX") || exit 1
    records_file=$(mktemp "${TMPDIR:-/tmp}/agent-radar-records.XXXXXX") || exit 1
    "$store_cmd" records > "$records_file"

    tmux list-panes -a -F '#{pane_id}|#{session_name}:#{window_index}.#{pane_index}|#{pane_tty}' 2>/dev/null |
    while IFS='|' read -r pane target tty; do
        agent=$(agent_for_tty "$tty" "$allow" || true)
        [ -n "$agent" ] || continue

        working=0
        if detect_working "$pane"; then working=1; fi
        printf '%s\n' "$pane" >> "$present_panes"

        last=; armed=; state=
        IFS='|' read -r last armed state <<EOF
$(record_hot "$pane")
EOF

        set_pane "$pane" agent "$agent"
        set_pane "$pane" target "$target"

        next_state=; next_last=; next_armed=; stopped_at=; notify=
        IFS='|' read -r next_state next_last next_armed stopped_at notify <<EOF
$(printf '%s|%s|%s|%s|%s|%s\n' "$state" "$last" "$armed" "$working" "$now" "$idle" | "$transition_cmd")
EOF

        set_pane "$pane" last_change "$next_last"
        set_pane "$pane" armed "$next_armed"
        set_pane "$pane" state "$next_state"
        set_pane "$pane" stopped_at "$stopped_at"
        # ponytail: no active-pane guard — tmux "active pane" != OS focus, so
        # guarding on it swallowed exactly the toasts you want while away. The
        # status segment already covers the "you're here" case (seen-on-focus).
        if [ "$notify" = 1 ]; then
            notify_stopped "$agent" "$target"
        fi
    done

    cut -d '|' -f 1 "$records_file" |
    while IFS= read -r pane; do
        [ -n "$pane" ] || continue
        grep -Fx "$pane" "$present_panes" >/dev/null 2>&1 || clear_pane "$pane"
    done

    rm -f "$present_panes" "$records_file"
}

start() {
    existing=$(pid_val)
    if [ -n "$existing" ] && kill -0 "$existing" 2>/dev/null; then
        exit 0
    fi

    if [ -z "$throttle_file" ]; then
        throttle_file=$(mktemp "${TMPDIR:-/tmp}/agent-radar-sound-throttle.XXXXXX") || exit 1
    fi
    # Arm the trap before pid_set: publishing the pid first leaves a window
    # where a stop signal kills the daemon without clearing @agent-radar-pid.
    trap 'rm -f "$throttle_file"; pid_unset "$$"; exit 0' INT TERM HUP EXIT
    pid_set "$$"

    # ponytail: list-sessions only needs the server, not an attached client;
    # display-message failed whenever every client briefly detached, ending
    # the daemon for good with no error.
    while tmux list-sessions >/dev/null 2>&1; do
        # ponytail: the dead-pid takeover above isn't atomic (read, then a
        # separate write) — a fast heartbeat re-invoking start() (see
        # agent-radar-status) can fire two takeovers before the first
        # write is visible to the second. Losing this check means someone
        # else won since we set our own pid; step aside within one poll
        # cycle instead of running forever alongside the winner.
        [ "$(pid_val)" = "$$" ] || break
        started=$(date +%s)
        # ponytail: don't let one bad cycle (a pane closing mid-poll, a
        # transient tmux/ps hiccup) kill the whole daemon under set -e.
        poll_once || true
        interval=$(opt @agent-radar-poll-interval 2)
        valid_number "$interval" || interval=2
        elapsed=$(($(date +%s) - started))
        [ "$elapsed" -lt "$interval" ] && sleep $((interval - elapsed))
    done

    pid_unset "$$"
}

stop() {
    existing=$(pid_val)
    [ -n "$existing" ] && kill "$existing" 2>/dev/null || true
    pid_unset
}

case "${1:-start}" in
    start) start ;;
    once) poll_once ;;
    stop) stop ;;
    restart) stop; start ;;
    *) echo "usage: $0 [start|once|stop|restart]" >&2; exit 2 ;;
esac
