#!/usr/bin/env sh
# shellcheck shell=sh disable=SC1007
set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P) || exit 1
status=$script_dir/agent-radar-status
tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-radar-status-test.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT INT TERM HUP

fixture=$tmp/env
log=$tmp/tmux.log
: > "$log"
cat > "$fixture" <<'EOF'
TMUX_AGENT_RADAR_PANE_%1_AGENT=pi
TMUX_AGENT_RADAR_PANE_%1_TARGET=work:2.1
TMUX_AGENT_RADAR_PANE_%1_STATE=stopped
TMUX_AGENT_RADAR_PANE_%1_STOPPED_AT=100
TMUX_AGENT_RADAR_PANE_%2_AGENT=claude
TMUX_AGENT_RADAR_PANE_%2_TARGET=work:3.0
TMUX_AGENT_RADAR_PANE_%2_STATE=stopped
TMUX_AGENT_RADAR_PANE_%2_STOPPED_AT=100
TMUX_AGENT_RADAR_PANE_%2_SEEN_STOPPED_AT=100
TMUX_AGENT_RADAR_PANE_%3_AGENT=codex
TMUX_AGENT_RADAR_PANE_%3_TARGET=other:1.0
TMUX_AGENT_RADAR_PANE_%3_STATE=working
EOF

mkdir "$tmp/bin"
cat > "$tmp/bin/tmux" <<'EOF'
#!/usr/bin/env sh
case "$1" in
    display-message)
        if [ "$2" = -p ] && [ "$3" = '#{session_name}' ]; then
            printf 'work\n'
            exit 0
        fi
        if [ "$2" = -p ] && [ "$3" = -t ] && [ "$4" = work ] && [ "$5" = '#{pane_id}' ]; then
            printf '%%9\n'
            exit 0
        fi
        echo "unexpected display-message $*" >&2; exit 1
        ;;
    show-option) exit 0 ;;
    list-sessions) printf 'work\nother\n' ;;
    list-windows) printf 'work:2\nwork:3\nother:1\n' ;;
    set-window-option)
        printf '%s\n' "$*" >> "$TMUX_LOG"
        ;;
    set-environment)
        printf '%s\n' "$*" >> "$TMUX_LOG"
        ;;
    run-shell)
        printf '%s\n' "$*" >> "$TMUX_LOG"
        ;;
    *) echo "unexpected tmux $*" >&2; exit 1 ;;
esac
EOF
chmod +x "$tmp/bin/tmux"

PATH=$tmp/bin:$PATH AGENT_RADAR_STORE_FILE=$fixture TMUX_LOG=$log "$status" work > "$tmp/out"
[ -z "$(cat "$tmp/out")" ] || { echo 'agent-radar-status produced stdout output' >&2; cat "$tmp/out"; exit 1; }

grep -Fx "run-shell -b '$script_dir/agent-radar-poller' start" "$log" >/dev/null || {
    echo 'poller heartbeat was not invoked' >&2
    exit 1
}

# --- heartbeat: skipped (no fork) when a live pid already owns the poller ---
test_pid=$$
log2=$tmp/tmux2.log
: > "$log2"
mkdir "$tmp/bin2"
cat > "$tmp/bin2/tmux" <<EOF
#!/usr/bin/env sh
case "\$1" in
    display-message)
        if [ "\$2" = -p ] && [ "\$3" = '#{session_name}' ]; then
            printf 'work\n'
            exit 0
        fi
        if [ "\$2" = -p ] && [ "\$3" = -t ] && [ "\$4" = work ] && [ "\$5" = '#{pane_id}' ]; then
            printf '%%9\n'
            exit 0
        fi
        echo "unexpected display-message \$*" >&2; exit 1
        ;;
    show-option)
        [ "\$3" = '@agent-radar-pid' ] && printf '%s\n' "$test_pid" || exit 0
        ;;
    list-sessions) printf 'work\nother\n' ;;
    list-windows) printf 'work:2\nwork:3\nother:1\n' ;;
    set-window-option) printf '%s\n' "\$*" >> "$log2" ;;
    set-environment) printf '%s\n' "\$*" >> "$log2" ;;
    run-shell) printf '%s\n' "\$*" >> "$log2" ;;
    *) echo "unexpected tmux \$*" >&2; exit 1 ;;
esac
EOF
chmod +x "$tmp/bin2/tmux"

PATH=$tmp/bin2:$PATH AGENT_RADAR_STORE_FILE=$fixture TMUX_LOG=$log2 "$status" work > /dev/null

if grep -q 'run-shell' "$log2"; then
    echo 'poller heartbeat forked a run-shell even though a live pid owns it' >&2
    exit 1
fi

printf 'agent-radar-status ok\n'
