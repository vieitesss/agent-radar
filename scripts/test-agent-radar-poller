#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P) || exit 1
poller=$script_dir/agent-radar-poller
tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-radar-poller-test.XXXXXX") || exit 1
dead_job_pid=
trap '[ -n "${dead_job_pid:-}" ] && kill "$dead_job_pid" 2>/dev/null; rm -rf "$tmp"' EXIT INT TERM HUP

fixture=$tmp/env
log=$tmp/tmux.log
cat > "$fixture" <<'EOF'
TMUX_AGENT_RADAR_PANE_%1_AGENT=opencode
TMUX_AGENT_RADAR_PANE_%1_TARGET=test:1.0
TMUX_AGENT_RADAR_PANE_%1_LAST_CHANGE=100
TMUX_AGENT_RADAR_PANE_%1_ARMED=1
TMUX_AGENT_RADAR_PANE_%1_STATE=stopped
TMUX_AGENT_RADAR_PANE_%1_STOPPED_AT=100
TMUX_AGENT_RADAR_PANE_%3_TARGET=test:1.2
TMUX_AGENT_RADAR_PANE_%3_LAST_CHANGE=100
TMUX_AGENT_RADAR_PANE_%3_ARMED=1
TMUX_AGENT_RADAR_PANE_%3_STATE=stopped
TMUX_AGENT_RADAR_PANE_%3_STOPPED_AT=100
TMUX_AGENT_RADAR_PANE_%4_TARGET=test:1.3
TMUX_AGENT_RADAR_PANE_%4_LAST_CHANGE=100
TMUX_AGENT_RADAR_PANE_%4_ARMED=1
TMUX_AGENT_RADAR_PANE_%4_STATE=working
EOF

mkdir "$tmp/bin"
cat > "$tmp/bin/tmux" <<'EOF'
#!/usr/bin/env sh
case "$1" in
    show-option) exit 0 ;;
    list-panes) printf '%%1|test:1.0|/dev/ttys001\n%%2|test:1.1|/dev/ttys002\n%%3|test:1.2|/dev/ttys003\n%%4|test:1.3|/dev/ttys004\n' ;;
    capture-pane)
        [ "$1 $2 $3" = 'capture-pane -pJ -t' ] || { echo "unexpected capture-pane args: $*" >&2; exit 1; }
        case "$4" in
            %1) printf '⬝■■■■■■⬝  esc interrupt\n' ;;
            %2) printf '⚕ ❯ msg=interrupt · /queue · /bg · /steer · Ctrl+C cancel\n' ;;
            %3) printf '✻ Thinking… (12s · ↓ 300 tokens · esc to interrupt)\n' ;;
            %4) printf '✻ Worked for 1m 12s\n' ;;
            *) echo "unexpected capture-pane target: $*" >&2; exit 1 ;;
        esac
        ;;
    set-environment)
        case "$2" in
            -g) printf 'set %s=%s\n' "$3" "$4" >> "$TMUX_LOG" ;;
            -gu) printf 'unset %s\n' "$3" >> "$TMUX_LOG" ;;
            *) echo "unexpected set-environment args: $*" >&2; exit 1 ;;
        esac
        ;;
    *) echo "unexpected tmux $*" >&2; exit 1 ;;
esac
EOF
cat > "$tmp/bin/ps" <<'EOF'
#!/usr/bin/env sh
case "$1 $2 $3 $4 $5 $6" in
    '-t ttys001 -o comm= -o args=') printf '%s\n' 'opencode /usr/local/bin/opencode' ;;
    # macOS truncates comm to 12 chars in column output; args= stays complete.
    '-t ttys002 -o comm= -o args=') printf '%s\n' '-zsh -zsh' '/Users/vieitespr /Users/vieitesprefapp/.hermes/hermes-agent/venv/bin/python /Users/vieitesprefapp/.hermes/hermes-agent/hermes' ;;
    '-t ttys003 -o comm= -o args=') printf '%s\n' 'claude /home/user/.local/bin/claude' ;;
    '-t ttys004 -o comm= -o args=') printf '%s\n' 'claude /home/user/.local/bin/claude' ;;
    *) echo "unexpected ps $*" >&2; exit 1 ;;
esac
EOF
chmod +x "$tmp/bin/tmux" "$tmp/bin/ps"

PATH=$tmp/bin:$PATH AGENT_RADAR_STORE_FILE=$fixture TMUX_LOG=$log "$poller" once

grep -Fx 'set TMUX_AGENT_RADAR_PANE_%1_STATE=working' "$log" >/dev/null
grep -Fx 'unset TMUX_AGENT_RADAR_PANE_%1_STOPPED_AT' "$log" >/dev/null
if grep -F 'TMUX_AGENT_RADAR_PANE_%1_STATE=stopped' "$log" >/dev/null; then
    echo 'opencode square bar was classified stopped' >&2
    exit 1
fi

# --- hermes: python-launched harness must be found via argv, not comm ---
grep -Fx 'set TMUX_AGENT_RADAR_PANE_%2_AGENT=hermes' "$log" >/dev/null || {
    echo 'hermes pane was not detected via argv' >&2
    exit 1
}
grep -Fx 'set TMUX_AGENT_RADAR_PANE_%2_STATE=working' "$log" >/dev/null || {
    echo 'hermes prompt-line hint was classified stopped' >&2
    exit 1
}

# --- Claude Code: the live status line is working; a completed-turn summary is not.
grep -Fx 'set TMUX_AGENT_RADAR_PANE_%3_AGENT=claude' "$log" >/dev/null || {
    echo 'claude pane was not detected' >&2
    exit 1
}
grep -Fx 'set TMUX_AGENT_RADAR_PANE_%3_STATE=working' "$log" >/dev/null || {
    echo 'Claude Code live status line was classified stopped' >&2
    exit 1
}
grep -Fx 'set TMUX_AGENT_RADAR_PANE_%4_STATE=stopped' "$log" >/dev/null || {
    echo 'Claude Code completed-turn summary was classified working' >&2
    exit 1
}

# --- start(): takes over when @agent-radar-pid is stale (e.g. a SIGKILL
# left no live owner behind — nothing can trap that) ---
dead=$tmp/dead
mkdir "$dead" "$dead/bin"
dead_store=$dead/store
: > "$dead_store"
pidfile=$dead/pid
dead_pid=999999999
printf '%s\n' "$dead_pid" > "$pidfile"

cat > "$dead/bin/tmux" <<EOF
#!/usr/bin/env sh
case "\$1" in
    show-option)
        case "\$3" in
            @agent-radar-pid) cat "$pidfile" 2>/dev/null ;;
            @agent-radar-poll-interval) printf '0\n' ;;
            *) exit 0 ;;
        esac
        ;;
    set-option)
        case "\$2" in
            -gqu) : > "$pidfile" ;;
            *) printf '%s\n' "\$4" > "$pidfile" ;;
        esac
        ;;
    list-sessions) exit 0 ;;
    list-panes) exit 0 ;;
    *) echo "unexpected tmux \$*" >&2; exit 1 ;;
esac
EOF
chmod +x "$dead/bin/tmux"

PATH=$dead/bin:$PATH AGENT_RADAR_STORE_FILE=$dead_store "$poller" start &
dead_job_pid=$!

new_pid=
tries=0
while [ "$tries" -lt 50 ]; do
    candidate=$(cat "$pidfile" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" != "$dead_pid" ]; then
        new_pid=$candidate
        break
    fi
    tries=$((tries + 1))
    sleep 0.1
done

[ -n "$new_pid" ] || { echo 'start() never took over a dead pid' >&2; exit 1; }
kill -0 "$new_pid" 2>/dev/null || { echo 'start() recorded a pid that is not actually running' >&2; exit 1; }

kill "$new_pid" 2>/dev/null || true
tries=0
while [ "$tries" -lt 50 ] && [ -s "$pidfile" ]; do
    tries=$((tries + 1))
    sleep 0.1
done
[ -s "$pidfile" ] && { echo 'start() left @agent-radar-pid set after being stopped' >&2; exit 1; }
dead_job_pid=

# --- start(): a takeover race loser steps aside instead of running forever
# alongside the winner (start()'s dead-pid check-then-set isn't atomic) ---
race=$tmp/race
mkdir "$race" "$race/bin"
race_store=$race/store
: > "$race_store"
race_pidfile=$race/pid
race_dead_pid=999999998
printf '%s\n' "$race_dead_pid" > "$race_pidfile"

cat > "$race/bin/tmux" <<EOF
#!/usr/bin/env sh
case "\$1" in
    show-option)
        case "\$3" in
            @agent-radar-pid) cat "$race_pidfile" 2>/dev/null ;;
            @agent-radar-poll-interval) printf '0\n' ;;
            *) exit 0 ;;
        esac
        ;;
    set-option)
        case "\$2" in
            -gqu) : > "$race_pidfile" ;;
            *) printf '%s\n' "\$4" > "$race_pidfile" ;;
        esac
        ;;
    list-sessions) exit 0 ;;
    list-panes) exit 0 ;;
    *) echo "unexpected tmux \$*" >&2; exit 1 ;;
esac
EOF
chmod +x "$race/bin/tmux"

PATH=$race/bin:$PATH AGENT_RADAR_STORE_FILE=$race_store "$poller" start &
dead_job_pid=$!

loser_pid=
tries=0
while [ "$tries" -lt 50 ]; do
    candidate=$(cat "$race_pidfile" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" != "$race_dead_pid" ]; then
        loser_pid=$candidate
        break
    fi
    tries=$((tries + 1))
    sleep 0.1
done
[ -n "$loser_pid" ] || { echo 'start() never took over in the race setup' >&2; exit 1; }

# Simulate a second racer winning the takeover out from under the running loop.
winner_pid=424242
printf '%s\n' "$winner_pid" > "$race_pidfile"

tries=0
while [ "$tries" -lt 50 ]; do
    kill -0 "$loser_pid" 2>/dev/null || break
    tries=$((tries + 1))
    sleep 0.1
done
if kill -0 "$loser_pid" 2>/dev/null; then
    echo 'start() kept running after losing ownership' >&2
    kill "$loser_pid" 2>/dev/null || true
    exit 1
fi

current=$(cat "$race_pidfile")
[ "$current" = "$winner_pid" ] || { echo "the loser clobbered the winner's pid on its way out" >&2; exit 1; }
dead_job_pid=

# --- start(): no-ops (no duplicate daemon) when the recorded pid is alive ---
alive=$tmp/alive
mkdir "$alive" "$alive/bin"
alive_store=$alive/store
: > "$alive_store"
alive_pidfile=$alive/pid
printf '%s\n' "$$" > "$alive_pidfile"

cat > "$alive/bin/tmux" <<EOF
#!/usr/bin/env sh
case "\$1" in
    show-option)
        case "\$3" in
            @agent-radar-pid) cat "$alive_pidfile" 2>/dev/null ;;
            *) exit 0 ;;
        esac
        ;;
    *) echo "unexpected tmux \$*" >&2; exit 1 ;;
esac
EOF
chmod +x "$alive/bin/tmux"

PATH=$alive/bin:$PATH AGENT_RADAR_STORE_FILE=$alive_store "$poller" start
current=$(cat "$alive_pidfile")
[ "$current" = "$$" ] || { echo 'start() overwrote a pid that was already alive (spawned a duplicate)' >&2; exit 1; }

# --- Sound cue tests --------------------------------------------------------

sound=$tmp/sound
mkdir -p "$sound/bin"

# Provide a private PATH so host binaries (e.g. /usr/bin/canberra-gtk-play)
# do not leak into the sound-player probes.
for _tool in awk cat cut date dirname grep mktemp rm sort stat touch tr sh; do
    ln -s "$(command -v "$_tool")" "$sound/bin/$_tool"
done
rm -f "$sound/bin/tmux" "$sound/bin/ps" "$sound/bin/uname" "$sound/bin/notify-send"

sound_fixture=$sound/fixture
cat > "$sound_fixture" <<'EOF'
TMUX_AGENT_RADAR_PANE_%1_AGENT=opencode
TMUX_AGENT_RADAR_PANE_%1_TARGET=test:1.0
TMUX_AGENT_RADAR_PANE_%1_LAST_CHANGE=100
TMUX_AGENT_RADAR_PANE_%1_ARMED=1
TMUX_AGENT_RADAR_PANE_%1_STATE=working
TMUX_AGENT_RADAR_PANE_%1_STOPPED_AT=
EOF

cat > "$sound/bin/ps" <<'EOF'
#!/usr/bin/env sh
case "$1 $2 $3 $4 $5 $6" in
    '-t ttys001 -o comm= -o args=') printf '%s\n' 'opencode /usr/local/bin/opencode' ;;
    *) echo "unexpected ps $*" >&2; exit 1 ;;
esac
EOF
chmod +x "$sound/bin/ps"

cat > "$sound/bin/notify-send" <<'EOF'
#!/usr/bin/env sh
:
EOF
chmod +x "$sound/bin/notify-send"

write_tmux_mock() {
    _sound_value=$1
    _notify_value=${2-on}
    # 'unset' models a missing @agent-radar-notify: real `tmux show-option -gqv`
    # prints nothing at all, so opt() must fall back to its default. Every other
    # value (including an explicit empty string) is answered verbatim.
    case "$_notify_value" in
        unset) _notify_cmd=: ;;
        *) _notify_cmd="printf '$_notify_value\\n'" ;;
    esac
    cat > "$sound/bin/tmux" <<EOF
#!/usr/bin/env sh
case "\$1" in
    show-option)
        case "\$3" in
            @agent-radar-sound) printf '$_sound_value\n' ;;
            @agent-radar-notify) $_notify_cmd ;;
            @agent-radar-idle-seconds) printf '3\n' ;;
            @agent-radar-poll-interval) printf '2\n' ;;
            @agent-radar-processes) printf 'pi,claude,codex,opencode,hermes,aider,cursor\n' ;;
            *) exit 0 ;;
        esac
        ;;
    list-panes) printf '%%1|test:1.0|/dev/ttys001\n' ;;
    capture-pane)
        [ "\$1 \$2 \$3" = 'capture-pane -pJ -t' ] || { echo "unexpected capture-pane args: \$*" >&2; exit 1; }
        case "\$4" in
            %1) printf 'done\n' ;;
            *) echo "unexpected capture-pane target: \$*" >&2; exit 1 ;;
        esac
        ;;
    set-environment) : ;;
    *) echo "unexpected tmux \$*" >&2; exit 1 ;;
esac
EOF
    chmod +x "$sound/bin/tmux"
}

afplay_log=$sound/afplay.log
canberra_log=$sound/canberra.log
paplay_log=$sound/paplay.log

# Poll until $1 exists with at least $2 lines (~20ms interval, ~3s / 150 tries).
# Optional $3 overrides the try cap (shorter absence settles). Returns 0, or 1 on timeout.
wait_for() {
    _wf_file=$1
    _wf_min=$2
    _wf_max=${3:-150}
    _wf_n=0
    while [ "$_wf_n" -lt "$_wf_max" ]; do
        if [ -f "$_wf_file" ]; then
            _wf_lines=$(wc -l < "$_wf_file")
            if [ "$_wf_lines" -ge "$_wf_min" ]; then
                return 0
            fi
        fi
        _wf_n=$((_wf_n + 1))
        sleep 0.02
    done
    return 1
}

# --- OS notification option tests ----------------------------------------

# Pin the OS toast path to the Darwin shim so tests are deterministic
# across hosts and do not fire real notifications.
cat > "$sound/bin/uname" <<'EOF'
#!/usr/bin/env sh
printf 'Darwin\n'
EOF
chmod +x "$sound/bin/uname"

osascript_log=$sound/osascript.log
: > "$osascript_log"
cat > "$sound/bin/osascript" <<EOF
#!/usr/bin/env sh
printf 'osascript %s\n' "\$*" >> "$osascript_log"
EOF
chmod +x "$sound/bin/osascript"

# N1: @agent-radar-notify unset -> toast (opt falls back to on)
rm -f "$osascript_log"
write_tmux_mock off unset
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
wait_for "$osascript_log" 1 || {
    echo 'unset @agent-radar-notify did not emit OS toast (expected default on)' >&2
    exit 1
}

# N2: explicit on -> toast
rm -f "$osascript_log"
write_tmux_mock off on
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
wait_for "$osascript_log" 1 || {
    echo 'on @agent-radar-notify did not emit OS toast' >&2
    exit 1
}

# N3: off -> no toast
rm -f "$osascript_log"
write_tmux_mock off off
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
if wait_for "$osascript_log" 1 50 || [ -f "$osascript_log" ]; then
    echo 'off @agent-radar-notify emitted an OS toast' >&2
    exit 1
fi

# N4: typo 'flase' -> no toast
rm -f "$osascript_log"
write_tmux_mock off flase
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
if wait_for "$osascript_log" 1 50 || [ -f "$osascript_log" ]; then
    echo 'flase @agent-radar-notify emitted an OS toast' >&2
    exit 1
fi

# N5: wrong case 'ON' -> no toast
rm -f "$osascript_log"
write_tmux_mock off ON
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
if wait_for "$osascript_log" 1 50 || [ -f "$osascript_log" ]; then
    echo 'ON @agent-radar-notify emitted an OS toast' >&2
    exit 1
fi

# N6: empty value -> toast (opt treats empty as unset and defaults to on)
rm -f "$osascript_log"
write_tmux_mock off ''
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
wait_for "$osascript_log" 1 || {
    echo 'empty @agent-radar-notify did not emit OS toast (opt defaults empty to on)' >&2
    exit 1
}

# --- D1: sound off gate ---
write_tmux_mock off on
cat > "$sound/bin/afplay" <<EOF
#!/usr/bin/env sh
printf 'afplay %s\n' "\$*" >> "$afplay_log"
EOF
chmod +x "$sound/bin/afplay"

PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once

if wait_for "$afplay_log" 1 50 || [ -f "$afplay_log" ]; then
    echo 'afplay was called while @agent-radar-sound is off' >&2
    exit 1
fi

# --- D1b: default off (option unset -> no sound) ---
write_tmux_mock '' on
cat > "$sound/bin/uname" <<'EOF'
#!/usr/bin/env sh
printf 'Darwin\n'
EOF
chmod +x "$sound/bin/uname"
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once

if wait_for "$afplay_log" 1 50 || [ -f "$afplay_log" ]; then
    echo 'afplay was called while @agent-radar-sound is unset (must default to off)' >&2
    exit 1
fi

# NOTIFY characterization: explicit on → toast fires (sound=on)
# --- D2: Darwin sound on ---
write_tmux_mock on on
cat > "$sound/bin/uname" <<'EOF'
#!/usr/bin/env sh
printf 'Darwin\n'
EOF
chmod +x "$sound/bin/uname"

osascript_log=$sound/osascript.log
: > "$osascript_log"
cat > "$sound/bin/osascript" <<EOF
#!/usr/bin/env sh
printf 'osascript %s\n' "\$*" >> "$osascript_log"
EOF
chmod +x "$sound/bin/osascript"

: > "$afplay_log"
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
wait_for "$osascript_log" 1 || {
    echo 'Darwin OS notification was not emitted' >&2
    exit 1
}
wait_for "$afplay_log" 1 || {
    echo 'Darwin sound did not play Ping.aiff' >&2
    exit 1
}
grep -F '/System/Library/Sounds/Ping.aiff' "$afplay_log" >/dev/null || {
    echo 'Darwin sound did not play Ping.aiff' >&2
    exit 1
}

# --- D3: Linux canberra-gtk-play ---
write_tmux_mock on on
cat > "$sound/bin/uname" <<'EOF'
#!/usr/bin/env sh
printf 'Linux\n'
EOF
chmod +x "$sound/bin/uname"
cat > "$sound/bin/canberra-gtk-play" <<EOF
#!/usr/bin/env sh
printf 'canberra-gtk-play %s\n' "\$*" >> "$canberra_log"
EOF
chmod +x "$sound/bin/canberra-gtk-play"
rm -f "$sound/bin/afplay" "$canberra_log"

PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
wait_for "$canberra_log" 1 || {
    echo 'canberra-gtk-play was not invoked with -i complete' >&2
    exit 1
}
grep -F -- '-i complete' "$canberra_log" >/dev/null || {
    echo 'canberra-gtk-play was not invoked with -i complete' >&2
    exit 1
}

# --- D4: Linux paplay fallback ---
write_tmux_mock on on
cat > "$sound/bin/paplay" <<EOF
#!/usr/bin/env sh
printf 'paplay %s\n' "\$*" >> "$paplay_log"
EOF
chmod +x "$sound/bin/paplay"
rm -f "$sound/bin/canberra-gtk-play" "$paplay_log"

PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
wait_for "$paplay_log" 1 || {
    echo 'paplay did not play fallback sound' >&2
    exit 1
}
grep -F '/usr/share/sounds/freedesktop/stereo/complete.oga' "$paplay_log" >/dev/null || {
    echo 'paplay did not play fallback sound' >&2
    exit 1
}

# --- D5: no player on Linux ---
write_tmux_mock on on
rm -f "$sound/bin/canberra-gtk-play" "$sound/bin/paplay" "$sound/bin/afplay"
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once

# --- D6: throttle window ---
# Run with an env-var-supplied throttle file and a Darwin-afplay shim so the
# player path is deterministic: first call (old mtime) should fire; second call
# (mtime touched within the 3-second window) should be throttled.
write_tmux_mock on on
cat > "$sound/bin/uname" <<'EOF'
#!/usr/bin/env sh
printf 'Darwin\n'
EOF
chmod +x "$sound/bin/uname"
cat > "$sound/bin/afplay" <<EOF
#!/usr/bin/env sh
printf 'afplay %s\n' "\$*" >> "$afplay_log"
EOF
chmod +x "$sound/bin/afplay"
rm -f "$sound/bin/canberra-gtk-play" "$sound/bin/paplay" "$afplay_log"

throttle=$sound/throttle
touch -t 200001010000 "$throttle"

PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture AGENT_RADAR_SOUND_THROTTLE_FILE=$throttle "$poller" once
wait_for "$afplay_log" 1 || {
    echo 'afplay not invoked on first (unthrottled) stop' >&2
    exit 1
}
[ "$(wc -l < "$afplay_log")" -eq 1 ] || {
    echo 'afplay not invoked on first (unthrottled) stop' >&2
    exit 1
}

sleep 1
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture AGENT_RADAR_SOUND_THROTTLE_FILE=$throttle "$poller" once
if wait_for "$afplay_log" 2 50; then
    echo 'afplay invoked during throttle window' >&2
    exit 1
fi
[ "$(wc -l < "$afplay_log")" -eq 1 ] || {
    echo 'afplay invoked during throttle window' >&2
    exit 1
}

# --- Isolation tests: notify option independent of sound -----------------

# Ensure only the Darwin sound path is available.
rm -f "$sound/bin/canberra-gtk-play" "$sound/bin/paplay"

cat > "$sound/bin/uname" <<'EOF'
#!/usr/bin/env sh
printf 'Darwin\n'
EOF
chmod +x "$sound/bin/uname"

cat > "$sound/bin/osascript" <<EOF
#!/usr/bin/env sh
printf 'osascript %s\n' "\$*" >> "$osascript_log"
EOF
chmod +x "$sound/bin/osascript"

cat > "$sound/bin/afplay" <<EOF
#!/usr/bin/env sh
printf 'afplay %s\n' "\$*" >> "$afplay_log"
EOF
chmod +x "$sound/bin/afplay"

# I1: both on -> toast + sound
rm -f "$osascript_log" "$afplay_log"
write_tmux_mock on on
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
wait_for "$osascript_log" 1 || {
    echo 'both on: OS toast was not emitted' >&2
    exit 1
}
wait_for "$afplay_log" 1 || {
    echo 'both on: sound was not emitted' >&2
    exit 1
}

# I2: notify off, sound on -> no toast, sound plays
rm -f "$osascript_log" "$afplay_log"
write_tmux_mock on off
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
if wait_for "$osascript_log" 1 50 || [ -f "$osascript_log" ]; then
    echo 'notify off, sound on: OS toast was emitted' >&2
    exit 1
fi
wait_for "$afplay_log" 1 || {
    echo 'notify off, sound on: sound was not emitted' >&2
    exit 1
}

# I3: notify on, sound off -> toast, no sound
rm -f "$osascript_log" "$afplay_log"
write_tmux_mock off on
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
wait_for "$osascript_log" 1 || {
    echo 'notify on, sound off: OS toast was not emitted' >&2
    exit 1
}
if wait_for "$afplay_log" 1 50 || [ -f "$afplay_log" ]; then
    echo 'notify on, sound off: sound was emitted' >&2
    exit 1
fi

# I4: both off -> neither
rm -f "$osascript_log" "$afplay_log"
write_tmux_mock off off
PATH=$sound/bin AGENT_RADAR_STORE_FILE=$sound_fixture "$poller" once
if wait_for "$osascript_log" 1 50 || [ -f "$osascript_log" ]; then
    echo 'both off: OS toast was emitted' >&2
    exit 1
fi
if wait_for "$afplay_log" 1 50 || [ -f "$afplay_log" ]; then
    echo 'both off: sound was emitted' >&2
    exit 1
fi

printf 'agent-radar-poller ok\n'
